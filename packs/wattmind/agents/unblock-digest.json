  "workspace": {
    "type": "ephemeral",
    "retainOnFailure": true
  },
  "capabilities": {
    "filesystem": "workspace-only",
    "services": ["tracker:read"]
  },
  "limits": {
    "timeout_seconds": 300,
    "attempts": 1
  },
  "mutating": false,
