{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JanitorInput",
  "type": "object",
  "required": ["repo"],
  "properties": {
    "repo": {
      "type": "string",
      "description": "Repository identifier configured in config/repos.yaml"
    },
    "host": {
      "type": "string",
      "description": "Optional worker host placement target"
    }
  },
  "additionalProperties": false
}
