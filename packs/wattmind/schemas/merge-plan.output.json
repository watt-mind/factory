{
  "title": "factory.merge-plan/v2 — batched MERGE plan from the review ledger",
  "type": "object",
  "required": [
    "recommendation",
    "repo",
    "github",
    "base",
    "deployBranch",
    "plan",
    "fix",
    "escalate",
    "reviews",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "recommendation": {
      "enum": ["MERGE", "FIX", "ESCALATE", "REVIEW", "NOOP"]
    },
    "repo": { "type": "string", "minLength": 1 },
    "github": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "base": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "deployBranch": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "planRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo"],
        "additionalProperties": false,
        "properties": {
          "repo": { "type": "string", "minLength": 1 }
        }
      }
    },
    "plan": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "pr",
          "headSha",
          "baseSha",
          "headRef",
          "ticket",
          "action",
          "reason",
          "checksGreen",
          "mergeable",
          "ownedPathsValid",
          "handoffValid",
          "testsFalsifiable",
          "policySafe",
          "sensitive",
          "ambiguous"
        ],
        "additionalProperties": false,
        "properties": {
          "pr": { "type": "integer", "minimum": 1 },
          "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "headRef": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "ticket": {
            "type": "string",
            "pattern": "^([A-Z]+-[0-9]+|(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#?[0-9]+)$"
          },
          "action": { "const": "merge_pr" },
          "reason": { "type": "string", "minLength": 1 },
          "checksGreen": { "const": true },
          "mergeable": { "const": true },
          "ownedPathsValid": { "const": true },
          "handoffValid": { "const": true },
          "testsFalsifiable": { "const": true },
          "policySafe": { "const": true },
          "sensitive": { "const": false },
          "ambiguous": { "const": false }
        }
      }
    },
    "fix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pr",
          "headSha",
          "baseSha",
          "headRef",
          "ticket",
          "finding",
          "findingHash",
          "round",
          "mechanical",
          "withinOwnedPaths",
          "ownedPaths"
        ],
        "additionalProperties": false,
        "properties": {
          "pr": { "type": "integer", "minimum": 1 },
          "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "headRef": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "ticket": {
            "type": "string",
            "pattern": "^([A-Z]+-[0-9]+|(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#?[0-9]+)$"
          },
          "finding": { "type": "string", "minLength": 1 },
          "findingHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "round": { "type": "integer", "minimum": 1 },
          "mechanical": { "type": "boolean" },
          "withinOwnedPaths": { "type": "boolean" },
          "ownedPaths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "escalate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pr", "headSha", "ticket", "reason"],
        "additionalProperties": false,
        "properties": {
          "pr": { "type": "integer", "minimum": 1 },
          "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "ticket": {
            "type": "string",
            "pattern": "^([A-Z]+-[0-9]+|(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#?[0-9]+)$"
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pr", "headSha", "baseSha"],
        "additionalProperties": false,
        "properties": {
          "pr": { "type": "integer", "minimum": 1 },
          "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "headRef": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "ticket": {
            "type": "string",
            "pattern": "^([A-Z]+-[0-9]+|(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#?[0-9]+)$"
          }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "noopReason": {
      "enum": ["no_open_prs", "all_prs_held", "no_merge_candidates"]
    }
  }
}
