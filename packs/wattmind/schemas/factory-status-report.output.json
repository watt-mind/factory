{
  "title": "factory.status-report/v1 output artifact",
  "type": "object",
  "required": ["repos", "recommendedAction"],
  "additionalProperties": false,
  "properties": {
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "triage", "agentReady", "inProgress", "blocked"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "triage": { "type": "integer", "minimum": 0 },
          "agentReady": { "type": "integer", "minimum": 0 },
          "inProgress": { "type": "integer", "minimum": 0 },
          "blocked": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "recommendedAction": {
      "enum": ["dispatch", "triage", "merge", "unblock", "wait"]
    }
  }
}
