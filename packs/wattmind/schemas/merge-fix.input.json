{
  "title": "bounded mechanical merge fix request",
  "type": "object",
  "required": [
    "repo",
    "github",
    "base",
    "pr",
    "headSha",
    "baseSha",
    "headRef",
    "ticket",
    "finding",
    "findingHash",
    "round",
    "mechanical",
    "withinOwnedPaths",
    "ownedPaths"
  ],
  "additionalProperties": false,
  "properties": {
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "github": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "base": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "pr": { "type": "integer", "minimum": 1 },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "headRef": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "ticket": {
      "type": "string",
      "pattern": "^([A-Z]+-[0-9]+|(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#?[0-9]+)$"
    },
    "finding": { "type": "string", "minLength": 1 },
    "findingHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "round": { "type": "integer", "minimum": 1, "maximum": 2 },
    "mechanical": { "const": true },
    "withinOwnedPaths": { "const": true },
    "ownedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
