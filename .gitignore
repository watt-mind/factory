# Runtime state lives in ~/.factory/, never here.
node_modules/
*.log

# Dispatcher state: leases, session ids, budget ledger.
.factory/
state/

# Secrets are injected at run time (launchd env / op run), never committed.
.env
.env.*
!.env.example

# Operator-local routing, policy, and schedules. Tracked defaults live beside
# them as *.example.yaml; `factory init` scaffolds these without overwriting.
config/repos.yaml
config/policy.yaml
config/schedule.yaml

.DS_Store
graphify-out/

# FACTORY:HARNES:BEGIN
# Local harness symlinks from `factory emit` — not repo content
.claude/commands/factory-*.md
.cursor/commands/factory-*.md
# FACTORY:HARNES:END

# Event-runtime web bundle — built from source, never committed
event-runtime/web/dist/
