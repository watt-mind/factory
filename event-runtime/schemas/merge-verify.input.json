{
  "title": "exact merge landing verification for one apply batch",
  "type": "object",
  "required": ["repo", "github", "base", "landed", "finalSha"],
  "additionalProperties": false,
  "properties": {
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "github": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "base": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "finalSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "landed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["pr", "ticket", "headSha", "mergeSha", "headRef"],
        "additionalProperties": false,
        "properties": {
          "pr": { "type": "integer", "minimum": 1 },
          "ticket": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
          "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "mergeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "headRef": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
        }
      }
    }
  }
}
