{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["articleId", "sources", "summary", "cellVersion"],
  "properties": {
    "articleId": { "type": "string" },
    "cellVersion": { "type": "integer" },
    "summary": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "relevanceScore", "claims"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "relevanceScore": { "type": "number" },
          "claims": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
