{
  "title": "factory.agent-result/v1 — the result.json an agent writes in its workspace (docs/event-runtime.md §7, §9)",
  "type": "object",
  "required": ["schemaVersion", "terminalState"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "factory.agent-result/v1" },
    "terminalState": { "enum": ["completed", "refused"] },
    "reasonCode": { "type": "string", "minLength": 1 },
    "decision": {},
    "artifact": {},
    "evidence": {},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
