{
  "title": "factory.merge-review/v1 — one-PR cold verdict pinned to both head and base",
  "type": "object",
  "required": [
    "verdict",
    "repo",
    "github",
    "base",
    "deployBranch",
    "pr",
    "headSha",
    "baseSha",
    "plan",
    "fix",
    "escalate",
    "findings",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "verdict": { "enum": ["MERGE", "FIX", "ESCALATE"] },
    "repo": { "type": "string", "minLength": 1 },
    "github": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "base": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "deployBranch": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "pr": { "type": "integer", "minimum": 1 },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "headRef": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "ticket": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
    "plan": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pr",
          "headSha",
          "baseSha",
          "headRef",
          "ticket",
          "action",
          "reason",
          "checksGreen",
          "mergeable",
          "ownedPathsValid",
          "handoffValid",
          "testsFalsifiable",
          "policySafe",
          "sensitive",
          "ambiguous"
        ],
        "additionalProperties": false,
        "properties": {
          "pr": { "type": "integer", "minimum": 1 },
          "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "headRef": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "ticket": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
          "action": { "const": "merge_pr" },
          "reason": { "type": "string", "minLength": 1 },
          "checksGreen": { "const": true },
          "mergeable": { "const": true },
          "ownedPathsValid": { "const": true },
          "handoffValid": { "const": true },
          "testsFalsifiable": { "const": true },
          "policySafe": { "const": true },
          "sensitive": { "const": false },
          "ambiguous": { "const": false }
        }
      }
    },
    "fix": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pr",
          "headSha",
          "baseSha",
          "headRef",
          "ticket",
          "finding",
          "findingHash",
          "round",
          "mechanical",
          "withinOwnedPaths",
          "ownedPaths"
        ],
        "additionalProperties": false,
        "properties": {
          "pr": { "type": "integer", "minimum": 1 },
          "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "headRef": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "ticket": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
          "finding": { "type": "string", "minLength": 1 },
          "findingHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "round": { "type": "integer", "minimum": 1 },
          "mechanical": { "type": "boolean" },
          "withinOwnedPaths": { "type": "boolean" },
          "ownedPaths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "escalate": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["pr", "headSha", "ticket", "reason"],
        "additionalProperties": false,
        "properties": {
          "pr": { "type": "integer", "minimum": 1 },
          "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "ticket": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": { "type": "string", "minLength": 1 }
  }
}
