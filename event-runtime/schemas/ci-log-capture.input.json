{
  "title": "ci-log-capture input — the failed run whose log to capture",
  "type": "object",
  "required": ["repo", "runId"],
  "additionalProperties": false,
  "properties": {
    "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "runId": { "type": ["string", "integer"] }
  }
}
