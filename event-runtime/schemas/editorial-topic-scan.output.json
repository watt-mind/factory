{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["siteId", "candidates", "cellVersion"],
  "properties": {
    "siteId": { "type": "string" },
    "cellVersion": { "type": "integer" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "slug", "angle", "priority"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "angle": { "type": "string" },
          "priority": { "type": "integer" },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
