{
  "schemaVersion": "factory.artifact-view/v1",
  "title": "Unblock plan",
  "summary": "/summary",
  "status": {
    "path": "/recommendation",
    "tone": { "UNBLOCK": "ok", "NOOP": "muted" }
  },
  "sections": [
    {
      "path": "/plan",
      "as": "table",
      "label": "Plan",
      "columns": ["issueId", "action", "reason"],
      "groupBy": "action",
      "formats": { "issueId": "issue" },
      "tone": {
        "action": {
          "release-hold": "ok",
          "release-to-triage": "warn",
          "comment-evidence": "neutral"
        }
      }
    },
    {
      "path": "/repo",
      "as": "keyvalue",
      "label": "Repo",
      "formats": { "": "repo" }
    }
  ]
}
