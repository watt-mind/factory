{
  "id": "unblock-apply",
  "version": 1,
  "prompt": "agents/unblock-apply.md",
  "input_schema": "schemas/unblock-apply.input.json",
  "output_schema": "schemas/unblock-applied.output.json",
  "output_contract": "factory.unblock-applied/v1",
  "itemsField": "plan",
  "itemKey": "issueId",
  "actionRegistry": {
    "release-hold": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "state",
        "{issueId}",
        "Todo",
        "--remove",
        "ai:blocked",
        "--add",
        "ai:agent-ready"
      ]
    },
    "release-to-triage": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "state",
        "{issueId}",
        "Triage",
        "--remove",
        "ai:blocked"
      ]
    },
    "comment-evidence": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "comment",
        "{issueId}",
        "unblock: {reason}"
      ]
    }
  },
  "workspace": {
    "type": "ephemeral",
    "retainOnFailure": true
  },
  "capabilities": {
    "filesystem": "workspace-only",
    "services": ["tracker:write"]
  },
  "limits": {
    "timeout_seconds": 600,
    "attempts": 1
  },
  "mutating": true,
  "pins": {
    "agents/unblock-apply.md": "sha256:e97afe482eb0c95faa82fab3e560ea28bbb3cc07dfbd3d4f5fdc68e994e01897",
    "schemas/unblock-apply.input.json": "sha256:5b8cc4047352147f02b707c94b2c353f5c6c6e1ce9661c25d972c82c8dca1bcb",
    "schemas/unblock-applied.output.json": "sha256:023c01ef5c7f1a4e5d30fe29f7ba7a65b7cc1030bcc30d8ac5719d6cc4f24cde"
  }
}
