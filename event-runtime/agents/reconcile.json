{
  "id": "reconcile",
  "version": 1,
  "prompt": "agents/reconcile.md",
  "input_schema": "schemas/repo-loop.input.json",
  "output_schema": "schemas/command-result.output.json",
  "output_contract": "factory.command-result/v1",
  "command": [
    "bun",
    "{factoryRoot}/orchestrator/reconcile.mjs",
