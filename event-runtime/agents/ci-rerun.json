{
  "id": "ci-rerun",
  "version": 1,
  "prompt": "agents/ci-rerun.md",
  "input_schema": "schemas/ci-rerun.input.json",
  "output_schema": "schemas/command-result.output.json",
  "output_contract": "factory.command-result/v1",
  "command": [
    "gh",
    "run",
    "rerun",
