{
  "id": "triage-apply",
  "version": 1,
  "prompt": "agents/triage-apply.md",
  "input_schema": "schemas/triage-apply.input.json",
  "output_schema": "schemas/triage-applied.output.json",
  "output_contract": "factory.triage-applied/v1",
  "itemsField": "plan",
  "itemKey": "issueId",
  "actionRegistry": {
    "label-agent-ready": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "state",
        "{issueId}",
        "Todo",
        "--add",
        "ai:agent-ready",
        "--remove",
        "tier:light",
        "--remove",
        "tier:standard",
        "--remove",
        "tier:strong",
        "--add",
        "tier:{tier}",
        "--comment",
        "{tierReason}",
        "--repo",
        "{repo}"
      ]
    },
    "move-to-todo": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "state",
        "{issueId}",
        "Todo",
        "--repo",
        "{repo}"
      ]
    },
    "write-detail": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "detail",
        "{issueId}",
        "{detail}",
        "--repo",
        "{repo}"
      ]
    },
    "needs-detail": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "comment",
        "{issueId}",
        "triage: {reason}",
        "--repo",
        "{repo}"
      ]
    },
    "mark-duplicate": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "comment",
        "{issueId}",
        "triage: possible duplicate — {reason}",
        "--repo",
        "{repo}"
      ]
    },
    "needs-human": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "comment",
        "{issueId}",
        "triage: needs a human decision — {reason}",
        "--repo",
        "{repo}"
      ]
    }
  },
  "chainOutcome": {
    "precedence": [
      {
        "action": "label-agent-ready",
        "outcome": "SUPPLY_CHANGED"
      },
      {
        "action": "write-detail",
        "outcome": "DETAIL_CHANGED"
      }
    ],
    "default": "NO_CHANGE"
  },
  "workspace": {
    "type": "ephemeral",
    "retainOnFailure": true
  },
  "capabilities": {
    "filesystem": "workspace-only",
    "services": ["tracker:write"]
  },
  "limits": {
    "timeout_seconds": 600,
    "attempts": 1
  },
  "mutating": true,
  "pins": {
    "agents/triage-apply.md": "sha256:d2e3e9d66a52a4a7556b5ad47207dbba76239f0ab776a79d4addcc078fa26ff2",
    "schemas/triage-apply.input.json": "sha256:85934114723ea03556ce593ec023bbdf4fee72794a4177e9b2c2b215db2127d9",
    "schemas/triage-applied.output.json": "sha256:ee71d56edb6f4ae96375a37e4d80e2512dd2702fac935268c0439627f561b94b"
  }
}
