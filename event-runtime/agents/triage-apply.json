{
  "id": "triage-apply",
  "version": 1,
  "prompt": "agents/triage-apply.md",
  "input_schema": "schemas/triage-apply.input.json",
  "output_schema": "schemas/triage-applied.output.json",
  "output_contract": "factory.triage-applied/v1",
  "itemsField": "plan",
  "itemKey": "issueId",
  "actionRegistry": {
    "label-agent-ready": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "state",
        "{issueId}",
        "Todo",
        "--add",
        "ai:agent-ready",
        "--remove",
        "tier:light",
        "--remove",
        "tier:standard",
        "--remove",
        "tier:strong",
        "--add",
        "tier:{tier}"
      ]
    },
    "move-to-todo": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "state",
        "{issueId}",
        "Todo"
      ]
    },
    "write-detail": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "detail",
        "{issueId}",
        "{detail}"
      ]
    },
    "needs-detail": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "comment",
        "{issueId}",
        "triage: {reason}"
      ]
    },
    "mark-duplicate": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "comment",
        "{issueId}",
        "triage: possible duplicate — {reason}"
      ]
    },
    "needs-human": {
      "argv": [
        "bun",
        "{factoryRoot}/tools/ticket.mjs",
        "comment",
        "{issueId}",
        "triage: needs a human decision — {reason}"
      ]
    }
  },
  "chainOutcome": {
    "precedence": [
      {
        "action": "label-agent-ready",
        "outcome": "SUPPLY_CHANGED"
      },
      {
        "action": "write-detail",
        "outcome": "DETAIL_CHANGED"
      }
    ],
    "default": "NO_CHANGE"
  },
  "workspace": {
    "type": "ephemeral",
    "retainOnFailure": true
  },
  "capabilities": {
    "filesystem": "workspace-only",
    "services": ["tracker:write"]
  },
  "limits": {
    "timeout_seconds": 600,
    "attempts": 1
  },
  "mutating": true,
  "pins": {
    "agents/triage-apply.md": "sha256:1546e127ffd3749640599354e4fe60972c01497a7a51458724667ad7b1021f48",
    "schemas/triage-apply.input.json": "sha256:e765ea02f17264c3c2ac0b938557a1bdf438f510d07511c1f883348c2a434133",
    "schemas/triage-applied.output.json": "sha256:ee71d56edb6f4ae96375a37e4d80e2512dd2702fac935268c0439627f561b94b"
  }
}
