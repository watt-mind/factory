{
  "reaper": {
    "every": "60m",
    "eventType": "clock.tick.reaper",
    "catchUp": "none",
    "singleton": true,
    "approval": "watched",
    "enabled": false
  },
  "work-factory": {
    "every": "30m",
    "eventType": "factory.work.requested",
    "payload": { "repo": "factory" },
    "catchUp": "none",
    "singleton": true,
    "approval": "auto",
    "enabled": true
  },
  "merge-factory": {
    "every": "4h",
    "eventType": "factory.merge.requested",
    "payload": { "repo": "factory" },
    "catchUp": "none",
    "singleton": true,
    "approval": "auto",
    "enabled": true
  },
  "triage-factory": {
    "every": "8h",
    "eventType": "factory.triage.requested",
    "payload": { "repo": "factory" },
    "catchUp": "none",
    "singleton": true,
    "approval": "auto",
    "enabled": true
  }
}
