{
  "cases": [
    {
      "name": "conforming nested object",
      "schema": {
        "type": "object",
        "required": ["name", "count"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 0 },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "value": { "name": "bj29", "count": 2, "tags": ["a"] },
      "valid": true
    },
    {
      "name": "unknown object property",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "name": { "type": "string" } }
      },
      "value": { "name": "bj29", "extra": true },
      "valid": false
    },
    {
      "name": "integer satisfies number",
      "schema": { "type": "number" },
      "value": 1,
      "valid": true
    },
    {
      "name": "fraction does not satisfy integer",
      "schema": { "type": "integer" },
      "value": 1.5,
      "valid": false
    },
    {
      "name": "nullable type array",
      "schema": { "type": ["string", "null"] },
      "value": null,
      "valid": true
    },
    {
      "name": "const mismatch",
      "schema": { "const": "factory.event/v1" },
      "value": "factory.event/v2",
      "valid": false
    },
    {
      "name": "enum match",
      "schema": { "enum": ["a", "b"] },
      "value": "b",
      "valid": true
    },
    {
      "name": "pattern mismatch",
      "schema": { "type": "string", "pattern": "^run_" },
      "value": "prop_1",
      "valid": false
    },
    {
      "name": "invalid pattern fails gracefully",
      "schema": { "type": "string", "pattern": "[" },
      "value": "anything",
      "valid": false
    },
    {
      "name": "array minimum",
      "schema": { "type": "array", "minItems": 1 },
      "value": [],
      "valid": false
    },
    {
      "name": "numeric bounds",
      "schema": { "type": "number", "minimum": 0, "maximum": 100 },
      "value": 150,
      "valid": false
    },
    {
      "name": "valid URI format",
      "schema": { "type": "string", "format": "uri" },
      "value": "https://example.test/path",
      "valid": true
    },
    {
      "name": "invalid URI format",
      "schema": { "type": "string", "format": "uri" },
      "value": "not a url",
      "valid": false
    },
    {
      "name": "valid duration format",
      "schema": { "type": "string", "format": "duration" },
      "value": "15ms",
      "valid": true
    },
    {
      "name": "unknown format fails closed",
      "schema": { "type": "string", "format": "uuid" },
      "value": "123",
      "valid": false
    },
    {
      "name": "unsupported keyword fails closed",
      "schema": { "anyOf": [{ "type": "string" }] },
      "value": "x",
      "valid": false
    },
    {
      "name": "additional properties schema",
      "schema": {
        "type": "object",
        "additionalProperties": { "type": "integer" },
        "properties": { "name": { "type": "string" } }
      },
      "value": { "name": "safe", "retries": "three" },
      "valid": false
    }
  ]
}
