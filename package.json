    "warm": "bun orchestrator/run.mjs --only warm --once --apply --repo",
    "unblock-digest": "bun orchestrator/run.mjs --only unblock-digest --once --apply --repo",
    "unblock": "bun orchestrator/run.mjs --only unblock --once --apply --repo",
    "dispatch": "bun orchestrator/run.mjs --only dispatch --once --apply --repo",
    "reconcile": "bun orchestrator/run.mjs --only reconcile --once --apply --repo",
    "merge": "bun orchestrator/run.mjs --only merge --once --apply --repo",
    "janitor": "bun orchestrator/run.mjs --only janitor --once --apply --repo",
