{
  "name": "@watt-mind/factory",
  "version": "0.1.0",
  "description": "A runtime for self-improving agentic loops: dispatches coding agents against tracked tickets, verifies with CI, and merges through review.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/watt-mind/factory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watt-mind/factory.git"
  },
  "bugs": {
    "url": "https://github.com/watt-mind/factory/issues"
  },
  "keywords": [
    "agent",
    "agentic",
    "ai",
    "automation",
    "ci",
    "coding-agent",
    "orchestration",
    "dispatch"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "factory": "bin/factory"
  },
  "files": [
    "bin/",
    "build/",
    "orchestrator/",
    "tools/",
    "event-runtime/",
    "lib/",
    "runners/",
    "shared/",
    "packs/",
    "plugins/",
    "dist/",
    "demo/",
    "config/*.example.yaml",
    "config/mcp/",
    ".claude-plugin/",
    "AGENTS.md",
    "PACKS.md",
    "ROADMAP.md",
    "SETUP.md",
    "LICENSE",
    "NOTICE",
    "!**/*.test.mjs",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/test-support/**",
    "!event-runtime/web/e2e/**",
    "!event-runtime/web/node_modules/**"
  ],
  "scripts": {
    "prepublishOnly": "bun tools/publish.mjs --dry-run",
    "supervise": "bun orchestrator/run.mjs",
    "watch": "bun orchestrator/watch.jsx --repo",
    "linear-reaper": "bun orchestrator/run.mjs --only linear-reaper --once --apply --repo",
    "label-guard": "bun orchestrator/run.mjs --only label-guard --once --apply --repo",
    "triage": "bun orchestrator/run.mjs --only triage --once --apply --repo",
    "warm": "bun orchestrator/run.mjs --only warm --once --apply --repo",
    "unblock-digest": "bun orchestrator/run.mjs --only unblock-digest --once --apply --repo",
    "unblock": "bun orchestrator/run.mjs --only unblock --once --apply --repo",
    "dispatch": "bun orchestrator/run.mjs --only dispatch --once --apply --repo",
    "reconcile": "bun orchestrator/run.mjs --only reconcile --once --apply --repo",
    "merge": "bun orchestrator/run.mjs --only merge --once --apply --repo",
    "janitor": "bun orchestrator/run.mjs --only janitor --once --apply --repo",
    "emit": "bun build/emit.mjs",
    "check": "bun build/emit.mjs --check && bun run check:web",
    "check:web": "cd event-runtime/web && if [ -d node_modules ]; then bun run typecheck; else echo \"check:web: skipped (run 'bun install' in event-runtime/web to enable the TypeScript check)\"; fi",
    "link": "bun build/emit.mjs --link",
    "link-bin": "bun build/emit.mjs --link-bin",
    "link-repos": "bun build/emit.mjs --link-repos",
    "sync-floor": "bun build/emit.mjs --sync-floor",
    "economics": "bun orchestrator/economics.mjs",
    "schedule": "bun deploy/gen.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "bun test",
    "cells:test": "bun test event-runtime/lib/editorial-cells-unit.test.mjs",
    "cells:deploy": "celld deploy cells --bucket ${CELLD_BUCKET:-s3://factory-cells} --endpoint ${S3_ENDPOINT:-https://cd4a8238b8fc54de39e31da1fb0ee657.r2.cloudflarestorage.com} --region auto",
    "docs:dev": "cd site && bun run dev",
    "docs:build": "cd site && bun run build",
    "lint": "bun run lint:cycles && eslint .",
    "lint:cycles": "bun tools/check-import-cycles.mjs && bun tools/check-import-cycles.mjs --self-test",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "dependencies": {
    "@earendil-works/gondolin": "^0.12.0",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.5.0",
    "typescript-eslint": "^8.67.0"
  }
}
