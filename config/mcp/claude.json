{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@1.6.0",
        "--isolated",
        "--headless",
        "--viewport=1280x720",
        "--screenshotFormat=webp",
        "--screenshotQuality=70",
        "--screenshotMaxWidth=1280",
        "--acceptInsecureCerts",
        "--no-usage-statistics"
      ]
    }
  }
}
